<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0-windows;net10.0-windows;net9.0-windows;net8.0-windows</TargetFrameworks>
    <Company>Inwazy Technology</Company>
    <Copyright>Ji-Feng Tsai</Copyright>
    <Description>.NET 8/9/10/11 Windows x86 wrapper for ThinBasic (thinCore.dll): embed scripts, host keywords, parser helpers, arrays, isolation, hash tables, and module classes.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/jiowcl/ThinBasic.NET</RepositoryUrl>
    <PackageReleaseNotes>NuGet package includes thinCore.dll and thinBasic_UI.dll (runtimes/win-x86/native, copied to consumer output). Module-class, Hash, and Isolation APIs.</PackageReleaseNotes>
    <PackageTags>thinbasic;thincore;scripting;pinvoke;windows;x86</PackageTags>
    <Authors>Jiowcl</Authors>
    <PackageProjectUrl>https://github.com/jiowcl/ThinBasic.NET</PackageProjectUrl>
    <Platforms>AnyCPU;x86</Platforms>
    <Version>1.0.11</Version>
    <PackageIcon></PackageIcon>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <SignAssembly>false</SignAssembly>
    <ApplicationIcon>thinbasic.net.ico</ApplicationIcon>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <Optimize>true</Optimize>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="thinbasic.net.ico">
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Native DLLs: output copy for build/ProjectReference; runtimes/* + build/*.props for NuGet consumers. -->
  <ItemGroup>
    <None Include="Lib\thinBasic_UI.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>thinBasic_UI.dll</Link>
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x86/native</PackagePath>
    </None>
    <None Include="Lib\thinCore.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>thinCore.dll</Link>
      <Pack>true</Pack>
      <PackagePath>runtimes/win-x86/native</PackagePath>
    </None>
    <None Include="build\ThinBasic.NET.props">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </None>
    <None Include="build\ThinBasic.NET.props">
      <Pack>true</Pack>
      <PackagePath>buildTransitive</PackagePath>
    </None>
  </ItemGroup>

</Project>
